<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizarena.server.inspector.NetworkInspectorController"
            stylesheets="@../../css/inspector.css" styleClass="inspector">
    <top>
        <VBox spacing="10" styleClass="inspector-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Network Inspector" styleClass="inspector-title"/>
                <Label text="HOST ONLY · LIVE" styleClass="inspector-badge"/>
            </HBox>
            <Label text="Real events measured by the server: NIO TCP accepts, reads and writes, UDP discovery, heartbeats and multicast."
                   styleClass="inspector-muted" wrapText="true"/>
            <Label fx:id="tcpStats" styleClass="inspector-stat"/>
            <Label fx:id="udpStats" styleClass="inspector-stat"/>
            <Label fx:id="alertStats" styleClass="inspector-stat"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="eventTable" styleClass="inspector-table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="timeColumn" text="Time" prefWidth="100" sortable="false"/>
                <TableColumn fx:id="kindColumn" text="Kind" prefWidth="140" sortable="false"/>
                <TableColumn fx:id="connectionColumn" text="Connection" prefWidth="95" sortable="false"/>
                <TableColumn fx:id="remoteColumn" text="Remote" prefWidth="170" sortable="false"/>
                <TableColumn fx:id="bytesColumn" text="Bytes" prefWidth="70" sortable="false"/>
                <TableColumn fx:id="detailColumn" text="Detail" prefWidth="420" sortable="false"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="8" styleClass="inspector-footer">
            <Label text="Multicast announcement (supplementary; never answers or scores)" styleClass="inspector-muted"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="announceRoom" promptText="Room code" prefWidth="130" accessibleText="Room code"/>
                <TextField fx:id="announceMessage" promptText="e.g. Round starts in 1 minute" HBox.hgrow="ALWAYS"
                           accessibleText="Announcement message" onAction="#announce"/>
                <Button fx:id="announceButton" text="Send announcement" onAction="#announce" styleClass="inspector-button"/>
            </HBox>
            <Label fx:id="announceStatus" styleClass="inspector-feedback" wrapText="true"/>
            <padding><Insets top="12" right="18" bottom="14" left="18"/></padding>
        </VBox>
    </bottom>
</BorderPane>
